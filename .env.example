# Ключ подписи токенов. В любом общем окружении замените на длинную случайную строку:
#   openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string

# Срок жизни токена, часы
TOKEN_TTL_HOURS=72

# true — при пустой БД создать демо-приют, демо-пользователя и 4 анкеты
SEED_DEMO=true

# Разрешённые источники для прямых запросов к API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Хранить фото в Yandex Object Storage. Если пусто - фото лежат в томе Docker.
YANDEX_ACCESS_KEY_ID=
YANDEX_SECRET_ACCESS_KEY=
S3_BUCKET=pets-photos
